# Copy to .env before starting. Replace these in any publicly accessible environment.
POSTGRES_PASSWORD=autoapply_dev_only
JWT_SECRET=replace-with-a-long-random-64-character-secret
# Gemini API (Google AI Studio: https://aistudio.google.com/apikey) — tem prioridade se preenchida
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# OpenAI opcional (usada se GEMINI_API_KEY estiver vazia)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
# Comma-separated PUBLIC board identifiers; leave empty for demo/Remotive only.
GREENHOUSE_BOARDS=
LEVER_SITES=
ASHBY_BOARDS=
REMOTIVE_ENABLED=true
ARBEITNOW_ENABLED=false
